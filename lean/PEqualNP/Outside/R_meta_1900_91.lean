import PEqualNP.Defs

theorem PEqualNP.Outside.R_meta_1900_91
    (hcost : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) (C : PEqualNP.CircuitLowerBounds.Circuit), (∃ u v : Fin n, G.Adj u v) → (∀ a b c d : Fin n, a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d → G.Adj a b → G.Adj b c → G.Adj c d → ¬ G.Adj d a) → PEqualNP.MetaComplexity.Monotone2 C → (∀ x : Fin n → Bool, C.eval (List.ofFn x) = true ↔ ∃ u v : Fin n, G.Adj u v ∧ x u = true ∧ x v = true) → (∀ (j : ℕ) (g : PEqualNP.CircuitLowerBounds.Gate), C.gates[j]? = some g → g.op = PEqualNP.CircuitLowerBounds.GateOp.and → ∀ x : Fin n → Bool, (C.wires (List.ofFn x)).getD (n + j) false = true → ∃ u v : Fin n, G.Adj u v ∧ x u = true ∧ x v = true) → PEqualNP.BicliqueBlockCost.HasBlockCost G C.size)
    (hnormal : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) (C : PEqualNP.CircuitLowerBounds.Circuit), (∃ u v : Fin n, G.Adj u v) → (∀ a b c d : Fin n, a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d → G.Adj a b → G.Adj b c → G.Adj c d → ¬ G.Adj d a) → PEqualNP.MetaComplexity.Monotone2 C → (∀ x : Fin n → Bool, C.eval (List.ofFn x) = true ↔ ∃ u v : Fin n, G.Adj u v ∧ x u = true ∧ x v = true) → ∃ D : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 D ∧ (∀ x : Fin n → Bool, D.eval (List.ofFn x) = true ↔ ∃ u v : Fin n, G.Adj u v ∧ x u = true ∧ x v = true) ∧ D.size ≤ C.size ∧ ∀ (S : Finset (Fin n)), S.card ≤ 2 → (∀ a b, a ∈ S → b ∈ S → ¬ G.Adj a b) → ∀ (j : ℕ) (g : PEqualNP.CircuitLowerBounds.Gate), D.gates[j]? = some g → g.op = PEqualNP.CircuitLowerBounds.GateOp.and → (D.wires (List.ofFn (fun a => decide (a ∈ S)))).getD (n + j) false = false)
    (htest : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) (C : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 C → (∀ (S : Finset (Fin n)), S.card ≤ 2 → (∀ a b, a ∈ S → b ∈ S → ¬ G.Adj a b) → ∀ (j : ℕ) (g : PEqualNP.CircuitLowerBounds.Gate), C.gates[j]? = some g → g.op = PEqualNP.CircuitLowerBounds.GateOp.and → (C.wires (List.ofFn (fun a => decide (a ∈ S)))).getD (n + j) false = false) → ∀ (j : ℕ) (g : PEqualNP.CircuitLowerBounds.Gate), C.gates[j]? = some g → g.op = PEqualNP.CircuitLowerBounds.GateOp.and → ∀ x : Fin n → Bool, (C.wires (List.ofFn x)).getD (n + j) false = true → ∃ u v : Fin n, G.Adj u v ∧ x u = true ∧ x v = true) :
    ∀ (x1 : ℕ) (x2 : SimpleGraph (Fin x1)) (x3 : PEqualNP.CircuitLowerBounds.Circuit), (∃ (x4 : Fin x1) (x5 : Fin x1), x2.Adj x4 x5) → (∀ (x5 x6 x7 x8 : Fin x1), x5 ≠ x6 → x5 ≠ x7 → x5 ≠ x8 → x6 ≠ x7 → x6 ≠ x8 → x7 ≠ x8 → x2.Adj x5 x6 → x2.Adj x6 x7 → x2.Adj x7 x8 → ¬x2.Adj x8 x5) → PEqualNP.MetaComplexity.Monotone2 x3 → (∀ (x7 : Fin x1 → Bool), x3.eval (List.ofFn x7) = Bool.true ↔ ∃ (x8 : Fin x1) (x9 : Fin x1), x2.Adj x8 x9 ∧ x7 x8 = Bool.true ∧ x7 x9 = Bool.true) → PEqualNP.BicliqueBlockCost.HasBlockCost x2 x3.size := by
  intro n G C hE h4 hM hfun
  obtain ⟨D, hMD, hfunD, hsize, hpairs⟩ := hnormal n G C hE h4 hM hfun
  obtain ⟨F, hF, hFsize⟩ := hcost n G D hE h4 hMD hfunD (htest n G D hMD hpairs)
  exact ⟨F, hF, hFsize.trans hsize⟩
